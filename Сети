    Sub4("4. Транспортный<br/>(Transport)"):::layer
    Sub3("3. Сетевой<br/>(Network)"):::layer
    Sub2("2. Канальный<br/>(Data Link)"):::layer
    Sub1("1. Физический<br/>(Physical)"):::layer

    %% Соединение уровней
    Sub7 --> Sub6
    Sub6 --> Sub5
    Sub5 --> Sub4
    Sub4 --> Sub3
    Sub3 --> Sub2
    Sub2 --> Sub1

    %% Примеры протоколов (выносные блоки)
    P7(HTTP, DNS, SSH, FTP):::proto
    P6(SSL/TLS, JPEG, MP3):::proto
